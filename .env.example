# Stripe (Dashboard → Developers → API keys / Webhooks). Can also be managed in /admin/settings.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...     # used by the checkout page (Payment Element)
STRIPE_WEBHOOK_SECRET=whsec_...        # optional. Webhook URL: https://kylpymaailma.com/api/stripe-webhook – events: payment_intent.succeeded, payment_intent.payment_failed, charge.refunded

# Stock + order storage (Vercel → Storage → Upstash Redis / KV, adds these automatically)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# E-mails (resend.com, domain kylpymaailma.com verified)
RESEND_API_KEY=re_...
MAIL_FROM=Kylpymaailma <asiakaspalvelu@kylpymaailma.com>
MAIL_TO=asiakaspalvelu@kylpymaailma.com

# Cart cookie signing (any long random string)
CART_SECRET=

# Order admin at /admin (choose a strong password)
ADMIN_PASSWORD=

# Optional
SHOP_DOMAIN=kylpymaailma.com
MIN_ORDER_CENTS=0                      # minimum order value, 0 = none
GOOGLE_TAG_IDS=                        # comma-separated, e.g. AW-123456789,MC-ABCDEFGH (empty = no Google tag)
GOOGLE_ADS_PURCHASE_LABEL=             # comma-separated purchase conversion labels, e.g. AW-123456789/AbCdEf
TELEGRAM_BOT_TOKEN=                    # optional order notifications
TELEGRAM_CHAT_ID=
AUTO_RESTOCK_QTY=0                     # >0 puts a sold-out variant back to this quantity automatically (off by default)
