<!doctype html>
<html class="no-js" lang="fi" data-mode="light">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#F5F6F3">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    <link rel="preload" href="{{ 'hedvig-letters-serif-latin-400-normal.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ 'schibsted-grotesk-latin-wght-normal.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>

    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>

    {%- capture document_title -%}
      {%- if request.page_type == 'index' -%}
        {{ settings.brand_name }} – hijabit, khimarit ja abayat
      {%- elsif request.page_type == 'cart' -%}
        Ostoskori – {{ settings.brand_name }}
      {%- elsif request.page_type == 'search' -%}
        {%- if search.terms != blank -%}Haku: {{ search.terms }}{%- else -%}Haku{%- endif %} – {{ settings.brand_name }}
      {%- elsif request.page_type == '404' -%}
        Sivua ei löytynyt – {{ settings.brand_name }}
      {%- else -%}
        {{ page_title }}{% if current_tags %}, {{ current_tags | join: ', ' | downcase }}{% endif %}{% unless page_title contains settings.brand_name %} – {{ settings.brand_name }}{% endunless %}{% if current_page != 1 %} – sivu {{ current_page }}{% endif %}
      {%- endif -%}
    {%- endcapture -%}
    <title>{{ document_title | strip | strip_newlines }}</title>

    {% render 'meta-tags' %}
    {% render 'css-variables' %}

    {{ content_for_header }}

    {{ 'tw.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'km.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'tw.js' | asset_url }}" defer></script>
    <script src="{{ 'tw-extras.js' | asset_url }}" defer></script>

    <script>
      window.TW = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          search: {{ routes.search_url | json }},
          predictive: {{ routes.predictive_search_url | json }},
          recommendations: {{ routes.product_recommendations_url | json }}
        },
        moneyFormat: '{% raw %}{{amount_with_comma_separator}}{% endraw %} €',
        lowStock: {{ settings.low_stock_threshold | default: 3 }},
        strings: {
          added: "Lisätty ostoskoriin",
          error: "Jokin meni vikaan. Yritä uudelleen.",
          soldOut: "Loppu varastosta",
          addToCart: "Lisää ostoskoriin",
          preorder: "Ennakkotilaa",
          wishlistAdd: "Lisätty suosikkeihin",
          wishlistRemove: "Poistettu suosikeista",
          released: "Nyt saatavilla",
          noResults: "Ei tuloksia – kokeile toista hakusanaa."
        }
      };
    </script>
  </head>

  <body class="tw-body template-{{ request.page_type | handle }}{% if template.suffix %} template-{{ template.suffix | handle }}{% endif %}">
    <a class="tw-skip" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="tw-main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'tw-cart-drawer' %}
    {% render 'tw-search-overlay' %}
    {%- if settings.enable_bottom_nav -%}{% render 'tw-bottom-nav' %}{%- endif -%}
    {%- if settings.cookie_banner -%}{% render 'tw-cookie-banner' %}{%- endif -%}

    <div class="tw-toast" role="status" aria-live="polite" data-toast></div>

    {% render 'structured-data' %}
  </body>
</html>
