{%- liquid
  assign meta_description = page_description
  if meta_description == blank and request.page_type == 'index'
    assign meta_description = 'Kylpymaailma – hijabit, khimarit ja abayat. Pituus valitaan senttimetreinä, ilmainen toimitus Suomeen ja 14 päivän peruuttamisoikeus.'
  elsif meta_description == blank and request.page_type == 'product'
    assign meta_description = product.description | strip_html | truncate: 160
  endif
-%}
{%- if meta_description != blank -%}
  <meta name="description" content="{{ meta_description | escape }}">
{%- endif -%}
{%- if request.page_type == 'cart' or request.page_type == 'search' or request.page_type contains 'customers/' -%}
  <meta name="robots" content="noindex, follow">
{%- endif -%}
<meta property="og:site_name" content="{{ settings.brand_name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ page_title | escape }}">
<meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
<meta property="og:locale" content="fi_FI">
{%- if meta_description != blank -%}
  <meta property="og:description" content="{{ meta_description | escape }}">
{%- endif -%}
{%- if page_image -%}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
{%- endif -%}
{%- if request.page_type == 'product' -%}
  <meta property="product:price:amount" content="{{ product.price | money_without_currency | strip }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ page_title | escape }}">
{%- if meta_description != blank -%}
  <meta name="twitter:description" content="{{ meta_description | escape }}">
{%- endif -%}
