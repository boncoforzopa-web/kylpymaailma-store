<div class="tw-cookie" data-cookie-banner role="dialog" aria-modal="false" aria-labelledby="tw-cookie-title" aria-describedby="tw-cookie-text" hidden>
  <div class="tw-cookie__card">
    <p class="tw-cookie__title" id="tw-cookie-title">{{ settings.cookie_title }}</p>
    <p class="tw-small tw-muted" id="tw-cookie-text">
      {{ settings.cookie_text }}
      {%- if settings.privacy_page != blank %} <a href="{{ settings.privacy_page.url }}">Tietosuojaseloste</a>{% endif -%}
    </p>
    <div class="tw-cookie__prefs" data-cookie-prefs hidden>
      <label class="tw-switch"><input type="checkbox" checked disabled><span></span><b>Välttämättömät</b><small>Ostoskori, kassa ja tietoturva – aina käytössä.</small></label>
      <label class="tw-switch"><input type="checkbox" data-consent="preferences"><span></span><b>Asetukset</b><small>Muistaa valintasi, esimerkiksi viimeksi katsotut tuotteet.</small></label>
      <label class="tw-switch"><input type="checkbox" data-consent="analytics"><span></span><b>Tilastointi</b><small>Nimetön tieto siitä, miten kauppaa käytetään.</small></label>
      <label class="tw-switch"><input type="checkbox" data-consent="marketing"><span></span><b>Markkinointi</b><small>Kohdennettu mainonta muissa palveluissa.</small></label>
    </div>
    <div class="tw-cookie__actions">
      <button type="button" class="tw-btn tw-btn--gold tw-btn--sm" data-cookie-necessary>Vain välttämättömät</button>
      <button type="button" class="tw-btn tw-btn--ghost tw-btn--sm" data-cookie-settings aria-expanded="false">Asetukset</button>
      <button type="button" class="tw-btn tw-btn--glass tw-btn--sm" data-cookie-save hidden>Tallenna valinnat</button>
      <button type="button" class="tw-btn tw-btn--gold tw-btn--sm" data-cookie-all>Hyväksy kaikki</button>
    </div>
  </div>
</div>
