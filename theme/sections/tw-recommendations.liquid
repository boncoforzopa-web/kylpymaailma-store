<section class="tw-section tw-recos" data-recos data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related">
  <div class="tw-wrap">
    {%- if recommendations.performed? -%}
      {%- if recommendations.products_count > 0 -%}
        {% render 'tw-section-head', heading: section.settings.heading %}
        <div class="tw-grid tw-grid--4">
          {%- for product in recommendations.products -%}
            {% render 'tw-product-card', product: product, index: forloop.index0 %}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Recommendations",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sopii yhteen" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
