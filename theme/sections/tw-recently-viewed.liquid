{%- comment -%} Filled client-side from localStorage (tw-extras.js) using ?section_id=tw-card-render; hidden until there is something to show. {%- endcomment -%}
<section class="tw-section tw-recent" data-recently-viewed data-exclude="{{ product.handle }}" hidden>
  <div class="tw-wrap">
    <div class="tw-head"><div><h2 class="tw-h2">{{ section.settings.heading }}</h2></div></div>
    <div class="tw-grid tw-grid--4" data-recently-viewed-grid></div>
  </div>
</section>

{% schema %}
{
  "name": "Recently viewed",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Viimeksi katsomasi" } ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
