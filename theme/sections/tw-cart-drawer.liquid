<dialog class="tw-drawer tw-drawer--right" id="tw-cart" aria-label="Ostoskori">
  <div class="tw-drawer__panel" id="tw-cart-inner" data-cart-inner>
    <div class="tw-drawer__head">
      <p class="tw-drawer__title">Ostoskori <span class="tw-muted">({{ cart.item_count }})</span></p>
      <button type="button" class="tw-iconbtn" data-close aria-label="Sulje ostoskori">{% render 'tw-icon', name: 'close', size: 22 %}</button>
    </div>

    {%- if cart.item_count == 0 -%}
      <div class="tw-drawer__body tw-cart-empty">
        <div class="km-cartempty">
          <p class="tw-h3">Ostoskorisi on tyhjä</p>
          <p class="tw-muted tw-small">Toimitus on ilmainen kaikkiin tilauksiin.</p>
          <a href="{{ routes.all_products_collection_url }}" class="tw-btn tw-btn--gold">Katso valikoima</a>
        </div>
      </div>
    {%- else -%}
      {%- assign threshold = settings.free_shipping_threshold | times: 100 -%}
      {%- if threshold > 0 -%}
        {%- assign remaining = threshold | minus: cart.total_price -%}
        {%- assign pct = cart.total_price | times: 100 | divided_by: threshold | at_most: 100 -%}
        <div class="tw-ship">
          <p class="tw-small">
            {%- if remaining > 0 -%}Vielä <strong>{{ remaining | money_without_currency | strip | append: ' €' }}</strong> ilmaiseen toimitukseen{%- else -%}{% render 'tw-icon', name: 'check', size: 16 %} Saat <strong>ilmaisen toimituksen</strong>{%- endif -%}
          </p>
          <div class="tw-ship__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ pct }}" aria-label="Ilmaisen toimituksen raja"><span style="width: {{ pct }}%"></span></div>
        </div>
      {%- endif -%}

      <div class="tw-drawer__body">
        <ul class="tw-lines" role="list">
          {%- for item in cart.items -%}
            <li class="tw-line" data-line="{{ forloop.index }}" data-key="{{ item.key }}">
              <a href="{{ item.url }}" class="tw-line__media">
                {%- if item.image -%}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.product.title, widths: '160, 320' }}{%- endif -%}
              </a>
              <div class="tw-line__info">
                <a href="{{ item.url }}" class="tw-line__title">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}<p class="tw-muted tw-small">{{ item.variant.title }}</p>{%- endunless -%}
                <div class="tw-line__row">
                  <div class="tw-qty" data-qty>
                    <button type="button" data-qty-minus aria-label="Vähennä määrää">{% render 'tw-icon', name: 'minus', size: 16 %}</button>
                    <input type="number" inputmode="numeric" min="0" max="10" value="{{ item.quantity }}" data-line-qty aria-label="Määrä: {{ item.product.title | escape }}">
                    <button type="button" data-qty-plus aria-label="Lisää määrää">{% render 'tw-icon', name: 'plus', size: 16 %}</button>
                  </div>
                  <div class="tw-line__price"><strong>{{ item.final_line_price | money_without_currency | strip | append: ' €' }}</strong></div>
                </div>
                <button type="button" class="tw-linkbtn tw-small" data-line-remove>Poista</button>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      </div>

      <div class="tw-drawer__foot">
        <div class="tw-sumrow"><span>Välisumma</span><strong data-cart-total>{{ cart.total_price | money_without_currency | strip | append: ' €' }}</strong></div>
        <p class="tw-muted tw-small">Sis. alv {{ vat_label }}. Toimitus on ilmainen.</p>
        <form action="{{ routes.cart_url }}" method="post">
          {%- if cart.total_price < min_order -%}
            {%- assign min_missing = min_order | minus: cart.total_price -%}
            <div class="tw-minorder"><p class="tw-small">Pienin tilaus on <strong>{{ min_order | money_without_currency | strip | append: ' €' }}</strong>. Puuttuu vielä <strong>{{ min_missing | money_without_currency | strip | append: ' €' }}</strong>.</p><a href="/collections/all" class="tw-btn tw-btn--gold tw-btn--block">Jatka ostoksia</a></div>
          {%- else -%}
            <button type="submit" name="checkout" class="tw-btn tw-btn--gold tw-btn--block">Siirry kassalle</button>
          {%- endif -%}
        </form>
        <a href="{{ routes.cart_url }}" class="tw-btn tw-btn--ghost tw-btn--block">Näytä ostoskori</a>
      </div>
    {%- endif -%}
    <div class="tw-drawer__loading" aria-hidden="true"><span></span><span></span><span></span></div>
  </div>
</dialog>

{% schema %}
{ "name": "Cart drawer", "settings": [] }
{% endschema %}
