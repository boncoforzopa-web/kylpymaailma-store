{%- comment -%} Thank-you page after payment. `order` is the paid order; `pending` true while the payment is still processing. {%- endcomment -%}
<section class="tw-co tw-co--danke">
  <div class="tw-wrap tw-co__layout">
    <div class="tw-co__form">
      <section class="tw-co__step tw-co__hero">
        <span class="tw-co__check">{% render 'tw-icon', name: 'check', size: 28 %}</span>
        <p class="tw-small tw-muted">{% if pending %}Maksua käsitellään{% else %}Tilaus {{ order.number }}{% endif %}</p>
        <h1 class="tw-h2">{% if pending %}Melkein valmista{% else %}Kiitos{% if order.first_name != blank %}, {{ order.first_name }}{% endif %}! Tilauksesi on vastaanotettu.{% endif %}</h1>
        <p class="tw-muted">{% if pending %}Maksupalvelu vahvistaa vielä maksuasi. Kun maksu on vahvistettu, lähetämme tilausvahvistuksen osoitteeseen <b>{{ order.email }}</b>.{% else %}Tilausvahvistus on lähetetty osoitteeseen <b>{{ order.email }}</b>.{% endif %}</p>
        {%- unless pending -%}
        <div class="tw-co__steps">
          <span class="is-on"><i>✓</i>Tilattu</span><span class="is-on"><i>✓</i>Pakataan</span><span><i>3</i>Lähetetty</span><span><i>4</i>Toimitettu</span>
        </div>
        <p class="tw-co__eta">{% render 'tw-icon', name: 'truck', size: 18 %} Arvioitu toimitus <b>{{ order.delivery_window }}</b></p>
        {%- endunless -%}
        <div class="tw-co__ctas">
          <a href="/collections/all" class="tw-btn tw-btn--gold tw-btn--lg">Jatka ostoksia</a>
          {%- if order.receipt_url -%}<a href="{{ order.receipt_url }}" target="_blank" rel="noopener" class="tw-btn tw-btn--glass tw-btn--lg">Maksukuitti</a>{%- endif -%}
        </div>
      </section>

      <section class="tw-co__step">
        <h2 class="tw-h3">Toimitus ja maksu</h2>
        <div class="tw-co__grid">
          <div><p class="tw-small tw-muted">Toimitusosoite</p><p>{{ order.ship_name }}<br>{{ order.address.line1 }}{% if order.address.line2 != blank %}<br>{{ order.address.line2 }}{% endif %}<br>{{ order.address.postal_code }} {{ order.address.city }}<br>Suomi</p></div>
          <div><p class="tw-small tw-muted">Maksu</p><p>{{ order.payment_label }}<br><span class="tw-muted tw-small">{{ order.created | date: '%-d.%-m.%Y klo %H.%M' }}</span></p></div>
        </div>
        <p class="tw-small tw-muted">Kysyttävää tilauksesta? Vastaa tilausvahvistukseen tai kirjoita osoitteeseen <a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a>.</p>
      </section>
    </div>

    <aside class="tw-co__aside">
      <div class="tw-co__summary">
        <p class="tw-h3">Tuotteet</p>
        <ul class="tw-co__items" role="list">
          {%- for l in order.lines -%}
            <li class="tw-co__item">
              <span class="tw-co__thumb">{% if l.image %}<img src="{{ l.image }}" alt="" width="64" height="64">{% endif %}<b class="tw-co__qty">{{ l.quantity }}</b></span>
              <span class="tw-co__item-body"><a href="/products/{{ l.handle }}" class="tw-co__item-title">{{ l.title }}</a></span>
              <strong class="tw-co__item-price">{{ l.line_total | money_without_currency | strip | append: ' €' }}</strong>
            </li>
          {%- endfor -%}
        </ul>
        <div class="tw-co__sums">
          <div class="tw-sumrow"><span>Toimitus</span><span class="tw-co__free">Ilmainen</span></div>
          <div class="tw-sumrow tw-co__total"><span>Yhteensä</span><strong>{{ order.total | money_without_currency | strip | append: ' €' }}</strong></div>
          <p class="tw-small tw-muted">sis. alv {{ vat_label }}</p>
        </div>
      </div>
    </aside>
  </div>
</section>
