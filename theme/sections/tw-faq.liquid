<section class="tw-section tw-faq">
  <div class="tw-wrap tw-faq__layout">
    <div class="tw-faq__intro">
      {%- assign faq_h1 = false -%}{%- if template.name == 'page' -%}{%- assign faq_h1 = true -%}{%- endif -%}{% render 'tw-section-head', heading: section.settings.heading, text: section.settings.text, as_h1: faq_h1 %}
      {%- if section.settings.cta_link != blank -%}
        <a href="{{ section.settings.cta_link }}" class="km-textlink">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>
    <div class="tw-accordion" data-accordion>
      {%- for block in section.blocks -%}
        <details class="tw-acc"{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary class="tw-acc__q">
            <span>{{ block.settings.question }}</span>
            <span class="tw-acc__icon" aria-hidden="true">{% render 'tw-icon', name: 'plus', size: 18 %}</span>
          </summary>
          <div class="tw-acc__a"><div class="tw-rte">{{ block.settings.answer }}</div></div>
        </details>
      {%- endfor -%}
    </div>
  </div>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Usein kysyttyä" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "text", "id": "cta_label", "label": "Link label", "default": "Ota yhteyttä" },
    { "type": "url", "id": "cta_link", "label": "Link" },
    { "type": "checkbox", "id": "open_first", "label": "First question open", "default": true }
  ],
  "blocks": [
    { "type": "qa", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question" },
      { "type": "richtext", "id": "answer", "label": "Answer" }
    ] }
  ]
}
{% endschema %}
