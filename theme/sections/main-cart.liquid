<section class="tw-section tw-cartpage">
  <div class="tw-wrap">
    <div class="tw-head"><div><h1 class="tw-h1">Ostoskori</h1></div></div>
    {%- if request.__url contains 'stock=' -%}
      <p class="tw-error" role="alert">Jonkin tuotteen saatavuus on muuttunut. Tarkista ostoskorisi määrät.</p>
    {%- endif -%}
    {%- if cart.item_count == 0 -%}
      <div class="tw-empty">
        <p class="tw-h3">Ostoskorisi on tyhjä</p>
        <p class="tw-muted">Toimitus on ilmainen kaikkiin tilauksiin.</p>
        <a class="tw-btn tw-btn--gold" href="{{ routes.all_products_collection_url }}">Katso valikoima</a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" class="tw-cartpage__layout" id="tw-cart-form">
        <ul class="tw-lines tw-lines--page" role="list">
          {%- for item in cart.items -%}
            <li class="tw-line">
              <a href="{{ item.url }}" class="tw-line__media">
                {%- if item.image -%}{{ item.image | image_url: width: 320 | image_tag: loading: 'lazy', alt: item.product.title, widths: '160, 320' }}{%- endif -%}
              </a>
              <div class="tw-line__info">
                <a href="{{ item.url }}" class="tw-line__title">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}<p class="tw-muted tw-small">{{ item.variant.title }}</p>{%- endunless -%}
                <p class="tw-small tw-muted">Kappalehinta {{ item.final_price | money_without_currency | strip | append: ' €' }}</p>
                <div class="tw-line__row">
                  <div class="tw-qty" data-qty>
                    <button type="button" data-qty-minus aria-label="Vähennä määrää">{% render 'tw-icon', name: 'minus', size: 16 %}</button>
                    <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" max="10" inputmode="numeric" aria-label="Määrä: {{ item.product.title | escape }}">
                    <button type="button" data-qty-plus aria-label="Lisää määrää">{% render 'tw-icon', name: 'plus', size: 16 %}</button>
                  </div>
                  <div class="tw-line__price"><strong>{{ item.final_line_price | money_without_currency | strip | append: ' €' }}</strong></div>
                </div>
                <a href="/cart/change?line={{ forloop.index }}&quantity=0" class="tw-linkbtn tw-small">Poista</a>
              </div>
            </li>
          {%- endfor -%}
        </ul>
        <aside class="tw-summary">
          <p class="tw-h3">Yhteenveto</p>
          <div class="tw-sumrow"><span>Välisumma</span><strong>{{ cart.total_price | money_without_currency | strip | append: ' €' }}</strong></div>
          <div class="tw-sumrow"><span>Toimitus</span><span>Ilmainen</span></div>
          <p class="tw-muted tw-small">Sis. alv {{ vat_label }}.{% if settings.shipping_page != blank %} <a href="{{ settings.shipping_page.url }}">Toimitus ja maksu</a>{% endif %}</p>
          <div class="tw-field">
            <label for="CartNote">Lisätietoja tilaukseen</label>
            <textarea id="CartNote" name="note" rows="3">{{ cart.note }}</textarea>
          </div>
          <button type="submit" name="update" class="tw-btn tw-btn--ghost tw-btn--block">Päivitä ostoskori</button>
          {%- if cart.total_price < min_order -%}
            {%- assign min_missing = min_order | minus: cart.total_price -%}
            <div class="tw-minorder"><p class="tw-small">Pienin tilaus on <strong>{{ min_order | money_without_currency | strip | append: ' €' }}</strong>. Puuttuu vielä <strong>{{ min_missing | money_without_currency | strip | append: ' €' }}</strong>.</p><a href="/collections/all" class="tw-btn tw-btn--gold tw-btn--block">Jatka ostoksia</a></div>
          {%- else -%}
            <button type="submit" name="checkout" class="tw-btn tw-btn--gold tw-btn--lg tw-btn--block">Siirry kassalle</button>
          {%- endif -%}
          <ul class="tw-pdp__trust" role="list">
            <li>{% render 'tw-icon', name: 'lock', size: 18 %}<span>Turvallinen maksu</span></li>
            <li>{% render 'tw-icon', name: 'return', size: 18 %}<span>14 päivän peruuttamisoikeus</span></li>
          </ul>
        </aside>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
