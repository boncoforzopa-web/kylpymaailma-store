{%- assign c = section.settings.collection -%}
{%- if c != blank and c.products_count > 0 -%}
<section class="tw-section tw-products" id="{{ section.settings.anchor }}">
  <div class="tw-wrap">
    {%- assign link = c.url | default: section.settings.link -%}
    {% render 'tw-section-head', heading: section.settings.heading, text: section.settings.text, link: link, link_label: section.settings.link_label %}
    <div class="tw-grid tw-grid--{{ section.settings.columns }}">
      {%- for product in c.products limit: section.settings.limit -%}
        {% render 'tw-product-card', product: product, index: forloop.index0 %}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Product grid",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "select", "id": "columns", "label": "Columns", "default": "4", "options": [ { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ] }
  ]
}
{% endschema %}
